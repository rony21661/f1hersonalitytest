    const questions = [
      { text: "Ğ²Ñ‹ Ğ¸Ğ½Ñ‚Ñ€Ğ¾Ğ²ĞµÑ€Ñ‚ Ğ¸Ğ»Ğ¸ ÑĞºÑÑ‚Ñ€Ğ°Ğ²ĞµÑ€Ñ‚?", answers: [
