        ["Ğ½ĞµÑ‚, Ñ ÑÑ‚Ğ¾Ğ³Ğ¾ Ğ²Ğ¾Ğ¾Ğ±Ñ‰Ğµ Ğ½Ğµ Ğ´ĞµĞ»Ğ°Ñ", ["raikkonen","norris","ricciardo"]]
      ]},
      { text: "Ğ³Ğ¾Ñ‚Ğ¾Ğ²Ñ‹ Ğ»Ğ¸ Ğ²Ñ‹ Ğ¾Ñ‚Ğ´Ğ°Ñ‚ÑŒ Ğ²ÑĞµĞ³Ğ¾ ÑĞµĞ±Ñ Ñ€Ğ°Ğ´Ğ¸ ÑĞ²Ğ¾ĞµĞ¹ Ñ†ĞµĞ»Ğ¸?", answers: [
        ["Ğ´Ğ°, Ğ¾Ğ¿Ñ€ĞµĞ´ĞµĞ»Ñ‘Ğ½Ğ½Ğ¾", ["verstappen","schumacher","senna","hamilton"]],
        ["Ğ²Ğ¾Ğ·Ğ¼Ğ¾Ğ¶Ğ½Ğ¾", ["leclerc","norris","sainz","perez","antonelli"]],
        ["Ğ½Ğµ Ğ´ÑƒĞ¼Ğ°Ñ", ["raikkonen","ricciardo","bottas"]]
      ]},
      { text: "Ğ² ĞºĞ°Ğ±Ğ¸Ğ½ĞºÑƒ Ñ‚ÑƒĞ°Ğ»ĞµÑ‚Ğ°, Ğ³Ğ´Ğµ Ñ‚Ñ‹ Ğ½Ğ°Ñ…Ğ¾Ğ´Ğ¸ÑˆÑŒÑÑ, Ğ¿Ğ¾ÑÑ‚ÑƒÑ‡Ğ°Ğ»Ğ¸ÑÑŒ. Ñ‚Ğ²Ğ¾Ğ¸ Ğ´ĞµĞ¹ÑÑ‚Ğ²Ğ¸Ñ?", answers: [
        ["ÑĞºĞ°Ğ·Ğ°Ñ‚ÑŒ Â«Ğ·Ğ°Ğ½ÑÑ‚Ğ¾Â»", ["sainz","russell","piastri"]],
        ["Ğ³Ñ€Ğ¾Ğ¼ĞºĞ¾ Ğ¿Ğ¾ĞºĞ°ÑˆĞ»ÑÑ‚ÑŒ", ["raikkonen","hakkinen","bottas"]],
        ["Ğ°Ğ³Ñ€ĞµÑÑĞ¸Ğ²Ğ½Ğ¾ Ğ¿Ğ¾ÑÑ‚ÑƒÑ‡Ğ°Ñ‚ÑŒÑÑ Ğ² Ğ¾Ñ‚Ğ²ĞµÑ‚", ["verstappen","tsunoda"]],
        ["ÑˆÑƒĞ¼ĞµÑ‚ÑŒ Ğ³Ñ€Ğ¾Ğ¼Ñ‡Ğµ", ["ricciardo","norris"]],
        ["Ğ·Ğ°Ğ²Ğ¸Ğ·Ğ¶Ğ°Ñ‚ÑŒ Ğ¸Ğ·Ğ¾ Ğ²ÑĞµÑ… ÑĞ¸Ğ»", ["leclerc","vettel"]],
        ["ÑĞºĞ°Ğ·Ğ°Ñ‚ÑŒ Â«Ğ²Ğ¾Ğ¹Ğ´Ğ¸Ñ‚ĞµÂ»", ["norris","ricciardo"]],
        ["Ğ¾Ñ‚ĞºÑ€Ñ‹Ñ‚ÑŒ Ğ´Ğ²ĞµÑ€ÑŒ", ["tsunoda","verstappen"]]
      ]},
      { text: "Ğ´Ñ€Ğ°Ñ‚ÑŒÑÑ:", answers: [
        ["Ñ Ğ´Ñ€ÑƒĞ³Ğ¸Ğ¼Ğ¸", ["verstappen","senna","schumacher","alonso"]],
        ["Ñ ÑĞ¾Ğ±Ğ¾Ğ¹", ["leclerc","vettel","hamilton"]],
        ["Ñ Ñ‚Ğ¾Ğ±Ğ¾Ğ¹", ["tsunoda","norris"]],
        ["Ñ Ğ²Ğ¾Ğ·Ğ´ÑƒÑ…Ğ¾Ğ¼", ["ricciardo","raikkonen","bottas"]]
      ]},
      { text: "Ğ³Ğ´Ğµ Ğ¶Ğ¸Ñ‚ÑŒ?", answers: [
        ["Ğ² Ğ»ĞµÑÑƒ", ["raikkonen","hakkinen"]],
        ["Ğ² ĞºĞ²Ğ°Ñ€Ñ‚Ğ¸Ñ€Ğµ", ["piastri","russell"]],
        ["Ñ Ñ…Ğ¾Ñ‡Ñƒ Ğ±ĞµĞ»Ñ‹Ğ¹ Ğ´Ğ¾Ğ¼, Ğ³Ğ¾Ğ»ÑƒĞ±Ñ‹Ğµ ÑÑ‚Ğ°Ğ²Ğ½Ğ¸ Ğ¸ ĞºĞ¾Ğ¼Ğ½Ğ°Ñ‚Ñƒ Ñ Ğ²Ğ¸Ğ´Ğ¾Ğ¼ Ğ½Ğ° Ñ€ĞµĞºÑƒ, Ñ‡Ñ‚Ğ¾Ğ±Ñ‹ Ñ Ğ¼Ğ¾Ğ³Ğ»Ğ° Ñ€Ğ¸ÑĞ¾Ğ²Ğ°Ñ‚ÑŒ", ["leclerc","vettel","hamilton"]],
        ["Ğ½Ğ° Ğ²Ğ¸Ğ»Ğ»Ğµ", ["sainz","alonso","prost"]],
        ["Ğ² Ğ´Ğ¾Ğ¼Ğ¸ĞºĞµ", ["ricciardo","norris"]],
        ["Ğ² ĞºĞ»ĞµÑ‚ĞºĞµ", ["tsunoda","verstappen"]],
        ["Ğ½Ğµ Ğ·Ğ°Ğ´Ğ°Ğ²Ğ°Ğ¹Ñ‚Ğµ Ğ»Ğ¸ÑˆĞ½Ğ¸Ñ… Ğ²Ğ¾Ğ¿Ñ€Ğ¾ÑĞ¾Ğ²", ["raikkonen","bottas","verstappen"]]
      ]},
      { text: "ĞºĞ°Ğº Ñ‡Ğ°ÑÑ‚Ğ¾ Ğ²Ñ‹ Ğ¿ÑŒĞµÑ‚Ğµ ĞºĞ¾ĞºĞ°ĞºĞ°Ğ»Ñƒ:", answers: [
        ["ĞºĞ°Ğ¶Ğ´Ñ‹Ğ¹ Ğ´ĞµĞ½ÑŒ", ["verstappen","norris"]],
        ["Ğ¿Ğ°Ñ€Ñƒ Ñ€Ğ°Ğ· Ğ² Ğ½ĞµĞ´ĞµĞ»Ñ", ["sainz","leclerc"]],
        ["Ğ½ĞµÑĞºĞ¾Ğ»ÑŒĞºĞ¾ Ñ€Ğ°Ğ· Ğ² Ğ¼ĞµÑÑÑ†", ["russell","piastri","antonelli"]],
        ["Ñ Ğ½Ğµ Ğ¿ÑŒÑ ĞºĞ¾ĞºĞ°ĞºĞ°Ğ»Ñƒ", ["hamilton","vettel","raikkonen"]],
        ["Ğ¿ĞµĞ¿ÑĞ¸.", ["ricciardo","tsunoda","alonso"]]
      ]},
      { text: "Ğ²Ñ‹ Ğ¿Ğ¾Ğ´Ğ´ĞµÑ€Ğ¶Ğ¸Ğ²Ğ°ĞµÑ‚Ğµ Ğ¿Ğ¾Ñ€ÑĞ´Ğ¾Ğº Ğ² ÑĞ²Ğ¾ĞµĞ¹ Ñ€Ğ°Ğ±Ğ¾Ñ‡ĞµĞ¹ Ğ·Ğ¾Ğ½Ğµ?", answers: [
        ["Ğ´Ğ°, Ğ²ÑĞµ Ğ»ĞµĞ¶Ğ¸Ñ‚ Ğ½Ğ° ÑĞ²Ğ¾Ğ¸Ñ… Ğ¼ĞµÑÑ‚Ğ°Ñ…", ["russell","prost","schumacher"]],
        ["Ğ¸Ğ½Ğ¾Ğ³Ğ´Ğ° Ğ±Ñ‹Ğ²Ğ°ĞµÑ‚ Ğ±ĞµÑĞ¿Ğ¾Ñ€ÑĞ´Ğ¾Ğº, Ğ½Ğ¾ ÑÑ‚Ğ¾ Ğ¿Ñ€Ğ¾Ğ¸ÑÑ…Ğ¾Ğ´Ğ¸Ñ‚ Ñ€ĞµĞ´ĞºĞ¾ Ğ¸ Ğ¿Ğ¾Ñ‡Ñ‚Ğ¸ ÑÑ€Ğ°Ğ·Ñƒ ÑƒÑÑ‚Ñ€Ğ°Ğ½ÑĞµÑ‚ÑÑ", ["sainz","piastri","perez"]],
        ["Ğ´Ğ»Ñ Ğ¼ĞµĞ½Ñ Ğ²ÑĞµ Ñ‡Ğ¸ÑÑ‚Ğ¾, Ğ½Ğ¾ Ğ´Ñ€ÑƒĞ³Ğ¸Ğµ Ñ‚Ğ°Ğº Ğ±Ñ‹ Ğ½Ğµ ÑĞºĞ°Ğ·Ğ°Ğ»Ğ¸", ["verstappen","raikkonen","norris"]],
        ["Ğ³Ñ€ÑĞ·Ğ½Ğ¾ Ğ¸ Ğ¼Ğ½Ğµ Ğ²ÑĞµ Ñ€Ğ°Ğ²Ğ½Ğ¾", ["ricciardo","bottas","tsunoda"]],
        ["Ğ³Ñ€ÑĞ·Ğ½Ğ¾, Ğ½Ğ¾ Ñƒ Ğ¼ĞµĞ½Ñ Ğ½ĞµÑ‚ ÑĞ¸Ğ» Ğ½Ğ° ÑƒĞ±Ğ¾Ñ€ĞºÑƒ", ["leclerc","vettel"]]
      ]},
      { text: "Ğ²Ğ°Ñˆ Ğ»ÑĞ±Ğ¸Ğ¼Ñ‹Ğ¹ Ğ½Ğ°Ğ¿Ğ¸Ñ‚Ğ¾Ğº?", answers: [
        ["Ğ¿Ğ¾Ğ»ÑƒÑÑƒÑ…Ğ¾Ğµ ĞºÑ€Ğ°ÑĞ½Ğ¾Ğµ", ["vettel","raikkonen"]],
        ["Ğ·ĞµĞ»ĞµĞ½Ñ‹Ğ¹ Ñ‡Ğ°Ğ¹", ["hamilton","piastri"]],
        ["Ğ»Ğ¸Ğ¼Ğ¾Ğ½Ğ°Ğ´", ["norris"]],
        ["ĞºĞ¾Ğ»Ğ° Ğ·ĞµÑ€Ğ¾", ["verstappen","sainz"]],
        ["Ğ±ĞµĞ·Ğ°Ğ»ĞºĞ¾Ğ³Ğ¾Ğ»ÑŒĞ½Ğ¾Ğµ Ğ¿Ğ¸Ğ²Ğ¾", ["bottas"]],
        ["Ğ°Ğ¼ĞµÑ€Ğ¸ĞºĞ°Ğ½Ğ¾", ["russell","prost"]],
        ["Ğ³Ğ°Ğ·Ğ¸Ñ€Ğ¾Ğ²Ğ°Ğ½Ğ½Ğ°Ñ Ğ²Ğ¾Ğ´Ğ°", ["alonso","schumacher"]],
        ["Ğ²Ğ¾Ğ´Ğ°", ["hakkinen","raikkonen"]],
        ["ÑĞ½ĞµÑ€Ğ³ĞµÑ‚Ğ¸Ğº", ["tsunoda","leclerc","norris"]]
      ]}
    ];

    const screens = {
      start: document.getElementById("start-screen"),
      quiz: document.getElementById("quiz-screen"),
      result: document.getElementById("result-screen")
    };
    const questionTitle = document.getElementById("question-title");
    const answersEl = document.getElementById("answers");
    const progressText = document.getElementById("progress-text");
    const progressPercent = document.getElementById("progress-percent");
    const progressFill = document.getElementById("progress-fill");
    const questionIndex = document.getElementById("question-index");
    const resultPhoto = document.getElementById("result-photo");

    let currentQuestion = 0;
    let scores = {};

    function showScreen(screenName) {
      Object.values(screens).forEach(screen => screen.classList.remove("active"));
      screens[screenName].classList.add("active");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function resetScores() {
      scores = Object.fromEntries(Object.keys(drivers).map(id => [id, 0]));
    }

    function renderQuestion() {
      const question = questions[currentQuestion];
      const number = currentQuestion + 1;
      progressText.textContent = `Ğ’Ğ¾Ğ¿Ñ€Ğ¾Ñ ${number} Ğ¸Ğ· ${questions.length}`;
      progressPercent.textContent = `${Math.round(number / questions.length * 100)}%`;
      progressFill.style.width = `${number / questions.length * 100}%`;
      questionIndex.textContent = `${String(number).padStart(2,"0")} / ${questions.length}`;
      questionTitle.textContent = question.text;
      answersEl.replaceChildren();

      question.answers.forEach(([answerText, driverIds]) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "answer-btn";
        button.textContent = answerText;
        button.addEventListener("click", () => chooseAnswer(driverIds));
        answersEl.appendChild(button);
      });

      const content = document.getElementById("question-content");
      content.style.animation = "none";
      void content.offsetWidth;
      content.style.animation = "screenIn .35s ease both";
    }

    function chooseAnswer(driverIds) {
      driverIds.forEach(id => {
        if (Object.prototype.hasOwnProperty.call(scores, id)) scores[id] += 1;
      });

      currentQuestion += 1;
      if (currentQuestion < questions.length) {
        renderQuestion();
      } else {
        showResult();
      }
    }

    function chooseWinner() {
      const highest = Math.max(...Object.values(scores));
      const leaders = Object.keys(scores).filter(id => scores[id] === highest);
      // ĞŸÑ€Ğ¸ Ñ€Ğ°Ğ²ĞµĞ½ÑÑ‚Ğ²Ğµ Ğ±Ğ°Ğ»Ğ»Ğ¾Ğ² Ğ²Ñ‹Ğ±Ğ¸Ñ€Ğ°ĞµĞ¼ ÑĞ»ÑƒÑ‡Ğ°Ğ¹Ğ½Ğ¾Ğ³Ğ¾ Ğ»Ğ¸Ğ´ĞµÑ€Ğ°.
      return leaders[Math.floor(Math.random() * leaders.length)];
    }

    function imageFallback(name) {
      const initials = name.split(" ").map(part => part[0]).slice(0,2).join("");
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="700" viewBox="0 0 1000 700"><defs><linearGradient id="g" x2="1" y2="1"><stop stop-color="#4a080d"/><stop offset="1" stop-color="#101010"/></linearGradient></defs><rect width="1000" height="700" fill="url(#g)"/><path d="M-50 600 L1050 100" stroke="#ed1c24" stroke-width="90" opacity=".6"/><text x="500" y="390" fill="white" font-family="Arial,sans-serif" font-size="190" font-weight="bold" text-anchor="middle">${initials}</text><text x="500" y="500" fill="#ddd" font-family="Arial,sans-serif" font-size="34" text-anchor="middle">DRIVER PROFILE</text></svg>`;
      return "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(svg);
    }

    async function loadDriverPhoto(driver) {
      resultPhoto.alt = `Ğ¤Ğ¾Ñ‚Ğ¾Ğ³Ñ€Ğ°Ñ„Ğ¸Ñ: ${driver.name}`;
      resultPhoto.src = imageFallback(driver.name);
      try {
        const endpoint = `https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(driver.wiki)}`;
        const response = await fetch(endpoint, { headers: { "Accept": "application/json" } });
        if (!response.ok) throw new Error("Image source unavailable");
        const data = await response.json();
        const photo = data.originalimage?.source || data.thumbnail?.source;
        if (photo) resultPhoto.src = photo;
      } catch (error) {
        // Ğ—Ğ°Ğ¿Ğ°ÑĞ½Ğ°Ñ ĞºĞ°Ñ€Ñ‚Ğ¾Ñ‡ĞºĞ° Ñ Ğ¸Ğ½Ğ¸Ñ†Ğ¸Ğ°Ğ»Ğ°Ğ¼Ğ¸ Ğ¾ÑÑ‚Ğ°Ñ‘Ñ‚ÑÑ Ğ½Ğ° Ğ¼ĞµÑÑ‚Ğµ, ĞµÑĞ»Ğ¸ API Ğ½ĞµĞ´Ğ¾ÑÑ‚ÑƒĞ¿ĞµĞ½.
      }
    }

    function showResult() {
      const winnerId = chooseWinner();
      const winner = drivers[winnerId];
      document.getElementById("result-name").textContent = winner.name;
      document.getElementById("result-description").textContent = winner.description;
      document.getElementById("result-number").textContent = "DRIVER PROFILE Â· F1";
      showScreen("result");
      loadDriverPhoto(winner);
    }

    document.getElementById("start-btn").addEventListener("click", () => {
      currentQuestion = 0;
      resetScores();
      showScreen("quiz");
      renderQuestion();
    });

    document.getElementById("restart-btn").addEventListener("click", () => {
      currentQuestion = 0;
      resetScores();
      showScreen("start");
      document.getElementById("player-name").value = "";
    });

    // Ğ˜Ğ½Ğ¸Ñ†Ğ¸Ğ°Ğ»Ğ¸Ğ·Ğ°Ñ†Ğ¸Ñ: Ğ²ÑĞµ 20 Ğ¿Ğ¸Ğ»Ğ¾Ñ‚Ğ¾Ğ² Ğ¸Ğ¼ĞµÑÑ‚ ÑĞ¾Ğ±ÑÑ‚Ğ²ĞµĞ½Ğ½Ñ‹Ğ¹ ÑÑ‡Ñ‘Ñ‚Ñ‡Ğ¸Ğº.
    resetScores();
  </script>


