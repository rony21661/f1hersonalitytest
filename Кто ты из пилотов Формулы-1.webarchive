  <style>
    :root {
      --bg: #080808;
      --panel: #111111;
      --panel-2: #171717;
      --line: rgba(255,255,255,.10);
      --muted: #929292;
      --white: #f5f5f5;
      --red: #ed1c24;
      --orange: #ff642d;
      --radius: 22px;
    }
    * { box-sizing: border-box; }
    html { min-height: 100%; background: var(--bg); }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--white);
      background:
        radial-gradient(ellipse at 50% -15%, rgba(237,28,36,.17), transparent 43%),
        radial-gradient(ellipse at 100% 75%, rgba(255,100,45,.06), transparent 32%),
        var(--bg);
      font-family: "Inter", Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    button, input { font: inherit; }
    button { -webkit-tap-highlight-color: transparent; }
    .site-shell { width: min(100% - 36px, 900px); margin: 0 auto; padding: 24px 0 44px; }
    .topbar { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:54px; }
    .brand { display:flex; align-items:center; gap:10px; font-size:12px; font-weight:900; letter-spacing:.18em; text-transform:uppercase; }
    .brand-mark { color:var(--red); font-size:23px; font-style:italic; letter-spacing:-.12em; transform:skew(-13deg); }
    .top-tag { color:#888; font-size:10px; letter-spacing:.16em; text-transform:uppercase; }
    .screen { display:none; }
    .screen.active { display:block; animation:screenIn .48s ease both; }
    @keyframes screenIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
    .hero { text-align:center; max-width:760px; margin:0 auto; }
    .eyebrow { display:inline-flex; align-items:center; gap:9px; color:#b7b7b7; font-size:10px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; }
    .eyebrow::before,.eyebrow::after { content:""; width:25px; height:1px; background:var(--red); }
    h1 { margin:20px 0 14px; font-size:clamp(37px, 8vw, 76px); line-height:.98; letter-spacing:-.075em; font-weight:900; text-transform:uppercase; }
    h1 span { color:var(--red); }
    .hero-copy { max-width:520px; margin:0 auto; color:#a4a4a4; font-size:14px; line-height:1.75; }
    .hero-art { position:relative; overflow:hidden; height:clamp(180px, 34vw, 290px); margin:34px auto 30px; border:1px solid rgba(255,255,255,.09); border-radius:var(--radius); background:linear-gradient(115deg,#151515,#090909 60%,#1b0909); }
    .hero-art::before { content:""; position:absolute; width:76%; height:130%; left:12%; top:-16%; border:2px solid rgba(255,255,255,.12); border-radius:50%; transform:rotate(-22deg); }
    .hero-art::after { content:""; position:absolute; width:60%; height:110%; left:20%; top:-7%; border:15px dashed rgba(237,28,36,.65); border-radius:50%; transform:rotate(-22deg); filter:drop-shadow(0 0 14px rgba(237,28,36,.25)); }
    .hero-art-label { position:absolute; z-index:1; inset:0; display:grid; place-items:center; }
    .hero-art-label strong { color:#fff; font-size:clamp(58px,15vw,130px); font-weight:900; font-style:italic; letter-spacing:-.13em; transform:skew(-12deg); text-shadow:0 10px 45px #000; }
    .hero-art-label small { position:absolute; bottom:20px; right:22px; color:#aaa; font-size:9px; letter-spacing:.22em; text-transform:uppercase; }
    .start-controls { display:flex; flex-direction:column; align-items:center; gap:13px; }
    .name-input { width:min(100%,360px); padding:16px 18px; color:#fff; background:#111; border:1px solid #303030; border-radius:12px; outline:none; text-align:center; transition:border .2s, box-shadow .2s; }
    .name-input::placeholder { color:#696969; }
    .name-input:focus { border-color:var(--red); box-shadow:0 0 0 3px rgba(237,28,36,.12); }
    .primary-btn { min-height:54px; min-width:min(100%,260px); padding:0 28px; border:0; border-radius:12px; color:white; background:linear-gradient(110deg,var(--red),#b90d17); font-size:12px; font-weight:900; letter-spacing:.14em; text-transform:uppercase; cursor:pointer; box-shadow:0 10px 30px rgba(237,28,36,.17); transition:transform .2s,filter .2s,box-shadow .2s; }
    .primary-btn:hover { transform:translateY(-3px); filter:brightness(1.12); box-shadow:0 14px 34px rgba(237,28,36,.28); }
    .primary-btn:active { transform:translateY(0) scale(.99); }
    .hint { color:#666; font-size:11px; }
    .quiz-wrap { max-width:700px; margin:0 auto; }
    .progress-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:13px; color:#8d8d8d; font-size:11px; letter-spacing:.08em; }
    .progress-head strong { color:#bcbcbc; font-weight:600; }
    .progress-track { width:100%; height:3px; overflow:hidden; background:#292929; border-radius:10px; margin-bottom:44px; }
    .progress-fill { height:100%; width:10%; background:linear-gradient(90deg,var(--red),var(--orange)); transition:width .35s ease; }
    .question-kicker { color:var(--red); font-size:10px; font-weight:800; letter-spacing:.2em; text-transform:uppercase; }
    .question-title { margin:14px 0 28px; font-size:clamp(25px,5vw,40px); line-height:1.2; letter-spacing:-.045em; font-weight:800; }
    .answers { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .answer-btn { min-height:68px; padding:17px 18px; display:flex; align-items:center; gap:13px; text-align:left; color:#e9e9e9; background:linear-gradient(135deg,#151515,#101010); border:1px solid #292929; border-radius:14px; cursor:pointer; font-size:13px; line-height:1.45; transition:background .2s,border-color .2s,transform .2s; }
    .answer-btn::before { content:""; flex:0 0 7px; width:7px; height:7px; border-radius:50%; background:#555; transition:background .2s,box-shadow .2s; }
    .answer-btn:hover { transform:translateY(-2px); border-color:rgba(237,28,36,.75); background:#1b1112; }
    .answer-btn:hover::before { background:var(--red); box-shadow:0 0 12px var(--red); }
    .answer-btn:focus-visible,.primary-btn:focus-visible { outline:2px solid var(--orange); outline-offset:3px; }
    .quiz-footer { display:flex; justify-content:space-between; align-items:center; margin-top:28px; color:#666; font-size:10px; letter-spacing:.12em; text-transform:uppercase; }
    .result-wrap { max-width:720px; margin:0 auto; text-align:center; }
    .result-photo-wrap { position:relative; overflow:hidden; width:100%; height:clamp(260px,55vw,480px); margin:0 auto 28px; border-radius:20px; background:linear-gradient(135deg,#26090b,#111); border:1px solid rgba(255,255,255,.12); }
    .result-photo { display:block; width:100%; height:100%; object-fit:cover; object-position:center 28%; filter:saturate(.88); }
    .photo-shade { position:absolute; inset:35% 0 0; background:linear-gradient(transparent,rgba(0,0,0,.75)); pointer-events:none; }
    .result-number { position:absolute; top:18px; left:18px; z-index:1; padding:8px 11px; border:1px solid rgba(255,255,255,.2); border-radius:7px; background:rgba(0,0,0,.45); color:#fff; font-size:9px; letter-spacing:.16em; }
    .result-label { color:#a7a7a7; font-size:11px; font-weight:700; letter-spacing:.25em; text-transform:uppercase; }
    .result-name { margin:13px 0 20px; color:#fff; font-size:clamp(28px,6vw,48px); line-height:1.05; font-weight:900; letter-spacing:-.06em; text-transform:uppercase; }
    .result-name::after { content:""; display:block; width:48px; height:3px; margin:17px auto 0; background:var(--red); }
    .result-description { max-width:650px; margin:0 auto 30px; color:#c3c3c3; font-size:14px; line-height:1.9; text-align:left; white-space:pre-line; }
    .result-actions { display:flex; justify-content:center; }
    .site-footer { margin-top:58px; text-align:center; color:#555; font-size:9px; letter-spacing:.16em; text-transform:uppercase; }
    .site-footer span { color:var(--red); }
    @media (max-width:600px) {
